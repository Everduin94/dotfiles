{
  "Import std": {
    "prefix": ["impStd"],
    "body": "const std = @import(\"std\");",
    "description": "Import the standard library"
  },
  "Import named module": {
    "prefix": ["impX"],
    "body": "const ${1:name} = @import(\"${2:name}\");$0",
    "description": "Import a module or file"
  },
  "Function with test": {
    "prefix": ["fnTest"],
    "body": [
      "/// ",
      "fn ${1:name}(io: Io, allocator: Allocator) !void {",
      "    $0",
      "}",
      "",
      "test $1 {",
      "",
      "}"
    ],
    "description": "Function plus a decl test for it"
  },
  "Spawn process": {
    "prefix": ["ioSpawn"],
    "body": [
      "var child = try std.process.spawn(io, .{",
      "    .argv = &.{ \"${1:command}\" },",
      "    .stdout = .pipe,",
      "    .stderr = .pipe,",
      "});",
      "$0"
    ],
    "description": "Spawn a child process with piped output"
  },
  "Run process": {
    "prefix": ["ioRun"],
    "body": [
      "const result = try std.process.run(allocator, io, .{",
      "    .argv = &.{ \"${1:command}\" },",
      "});",
      "defer allocator.free(result.stdout);",
      "defer allocator.free(result.stderr);",
      "",
      "if (result.term != .exited or result.term.exited != 0) {",
      "    return error.CommandFailed;",
      "}",
      "",
      "$0"
    ],
    "description": "Run a process and capture output (0.16 exit check; 0.17 may allow term.success())"
  },
  "Route param": {
    "prefix": ["apiRouteParam"],
    "body": [
      "const ${1:id} = req.param(\"$1\") orelse {",
      "    res.status = 400;",
      "    res.body = \"failed\";",
      "    return;",
      "};"
    ],
    "description": "httpz route param, 400 if missing"
  },
  "Query param": {
    "prefix": ["apiQueryParam"],
    "body": [
      "const query = try req.query();",
      "const ${1:name} = query.get(\"$1\") orelse {",
      "    res.status = 400;",
      "    res.body = \"fail\";",
      "    return;",
      "};"
    ],
    "description": "httpz query param, 400 if missing"
  },
  "Read JSON file": {
    "prefix": ["ioReadJson"],
    "body": [
      "const ${1:User} = struct { ${2:id}: ${3:i32} };",
      "const parsed = try readJson($1, ${4:std.testing.io}, ${5:std.testing.allocator}, \"${6:static/example.json}\", .{});",
      "defer parsed.deinit();",
      "// parsed.value.$2",
      "$0"
    ],
    "description": "Read a JSON file into a typed struct with readJson"
  },
  "POST endpoint": {
    "prefix": ["apiPostEndpoint"],
    "body": [
      "/// $2",
      "pub fn post${1:Name}(req: *httpz.Request, res: *httpz.Response) !void {",
      "    const io = req.conn.io;",
      "    const arena = req.arena;",
      "    $0",
      "",
      "    // res.body = \"success\";",
      "    // try res.json(.{ .props = \"1\", .ok = true }, .{});",
      "}",
      "",
      "test post$1 {",
      "    var web = httpz.testing.init(.{});",
      "    defer web.deinit();",
      "    web.json(.{ .name = \"ada\" });",
      "",
      "    try post$1(web.req, web.res);",
      "    try web.expectStatus(200);",
      "    // try web.expectJson(.{ .props = \"1\", .ok = true });",
      "}"
    ],
    "description": "httpz POST handler"
  },
  "GET endpoint": {
    "prefix": ["apiGetEndpoint"],
    "body": [
      "/// $2",
      "pub fn get${1:Name}(req: *httpz.Request, res: *httpz.Response) !void {",
      "    res.body = \"ok\";",
      "    $0",
      "}",
      "",
      "test get$1 {",
      "    var web = httpz.testing.init(.{});",
      "    defer web.deinit();",
      "    // web.param(\"id\", \"1\"); web.query(\"q\", \"v\"); web.header(\"x\", \"y\");",
      "",
      "    try get$1(web.req, web.res);",
      "    try web.expectStatus(200);",
      "    try web.expectBody(\"ok\");",
      "}"
    ],
    "description": "httpz GET handler"
  }
}
