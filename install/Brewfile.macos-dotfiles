# Install with:
#   brew bundle --file=install/Brewfile.macos-dotfiles

# Core
brew "git"
brew "stow"

# Shell / terminal
tap "neurosnap/tap"
brew "neurosnap/tap/zmx"
brew "starship"
brew "fzf"
brew "zoxide"
brew "yazi"

# Editor / CLI
brew "neovim"
brew "fd"
brew "ripgrep"
brew "jq"
brew "gh"
brew "tree-sitter"
brew "hunk"

# Window management
tap "asmvik/formulae"
brew "asmvik/formulae/yabai"
brew "asmvik/formulae/skhd"

# Status bar
tap "FelixKratz/formulae"
brew "FelixKratz/formulae/sketchybar"

# macOS apps
tap "anomalyco/tap"
cask "anomalyco/tap/hex"
cask "ghostty"
cask "karabiner-elements"
cask "raycast"

