# Function to source files if they exist
function zsh_add_file() {
    [ -f "$ZDOTDIR/$1" ] && source "$ZDOTDIR/$1"
}

# Fuzzy-find a zmx session, preview its scrollback, and attach to it.
function zmx-select() {
    if ! command -v zmx >/dev/null 2>&1; then
        echo "zmx-select: zmx is not installed" >&2
        return 1
    fi
    if ! command -v fzf >/dev/null 2>&1; then
        echo "zmx-select: fzf is not installed" >&2
        return 1
    fi

    local display
    local prefix="${ZMX_SESSION_PREFIX:-}"
    display=$(zmx list 2>/dev/null | while IFS=$'\t' read -r name pid clients created dir; do
        name=${name#*name=}
        pid=${pid#*pid=}
        clients=${clients#*clients=}
        dir=${dir#*start_dir=}
        if [[ -n "$prefix" ]]; then
            [[ "$name" == "$prefix"* ]] || continue
            name=${name#"$prefix"}
        fi
        printf "%-20s  pid:%-8s  clients:%-2s  %s\n" "$name" "$pid" "$clients" "$dir"
    done)

    local output query key selected session_name
    output=$({ [[ -n "$display" ]] && echo "$display"; } | fzf \
        --print-query \
        --expect=ctrl-n \
        --height=80% \
        --reverse \
        --prompt="zmx> " \
        --header="Enter: attach | Ctrl-N: create new | Esc: cancel" \
        --bind='every(1):refresh-preview' \
        --preview='zmx history {1}' \
        --preview-window=right:60%:follow)
    local rc=$?

    query=$(echo "$output" | sed -n '1p')
    key=$(echo "$output" | sed -n '2p')
    selected=$(echo "$output" | sed -n '3p')

    if [[ "$key" == "ctrl-n" && -n "$query" ]]; then
        session_name="$query"
    elif [[ $rc -eq 0 && -n "$selected" ]]; then
        session_name=$(echo "$selected" | awk '{print $1}')
    elif [[ -n "$query" ]]; then
        session_name="$query"
    else
        return 130
    fi

    zmx attach "$session_name"
}

# Open the Scholar persona in a persistent zmx session.
# Usage: scholar [short-session-name] [pi-options...]
function scholar() {
    local short_name="${1:-}"
    local session_name="scholar"

    if [[ -n "$short_name" ]]; then
        if [[ ! "$short_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
            echo "scholar: session name may only contain letters, numbers, dot, underscore, or hyphen" >&2
            return 1
        fi
        session_name="scholar-$short_name"
        shift
    fi

    zmx attach "$session_name" env \
        EDITOR='env PI_NVIM_INLINE=1 nvim' \
        VISUAL='env PI_NVIM_INLINE=1 nvim' \
        pi \
        --no-context-files \
        --no-skills \
        --no-extensions \
        -e "$HOME/dev/pi-persona-light" \
        --persona=scholar \
        "$@"
}

function jira() {
    local ticket_id="$1"
    local field_arg=""

    if [ -z "$ticket_id" ]; then
        echo "Usage: jira <TICKET-ID> [--field <field_name>]" >&2
        return 1
    fi

    # Shift past the first argument (ticket ID)
    shift

    # If --field was provided as the next arguments, pass them on to the python script
    if [ "$1" = "--field" ]; then
        field_arg="--field $2"
    fi

    local jira_base_url="${JIRA_BASE_URL:-$(pass "${JIRA_BASE_URL_PASS_ENTRY:-cisco/jira/base-url}")}"
    local jira_user_email="${JIRA_USER_EMAIL:-$(pass "${JIRA_USER_EMAIL_PASS_ENTRY:-cisco/jira/user-email}")}"

    curl -s \
      -u "${jira_user_email}:$(pass jira)" \
      -H "Accept: application/json" \
      "${jira_base_url%/}/rest/api/3/issue/${ticket_id}" | ~/.pi/agent/paladin/projects/avf/scripts/core/jira-to-md.py ${field_arg}
}

function figma() {
    local url="$1"
    local node_id="$2"
    if [ -z "$url" ]; then
        echo "Usage: figma <FIGMA-URL-OR-FILE-KEY> [NODE-ID]" >&2
        return 1
    fi

    local img_url
    if [ -n "$node_id" ]; then
        img_url=$(FIGMA_ACCESS_TOKEN="$(pass figma)" ~/.pi/agent/paladin/projects/avf/scripts/core/figma-image.py "$url" "$node_id")
    else
        img_url=$(FIGMA_ACCESS_TOKEN="$(pass figma)" ~/.pi/agent/paladin/projects/avf/scripts/core/figma-image.py "$url")
    fi

    if [ $? -eq 0 ] && [ -n "$img_url" ]; then
        echo "$img_url"
        # Copy to macOS clipboard
        echo -n "$img_url" | pbcopy
        echo "(Copied to clipboard!)" >&2
    else
        return 1
    fi
}

function create-task() {
    local template="$1"
    if [ -z "$template" ]; then
        echo "Usage: create-task <filled-template.md>" >&2
        return 1
    fi

    bun ~/.pi/turso-poller-tui/scripts/create-task.ts "$template"
}

function cxb() {
    local main_repo="$HOME/dev/cx-platform-ui-worktrees/cx-platform-ui"

    # git worktree list is sorted alphabetically by path, NOT by creation
    # order, so we can't assume the new worktree is the last line. Diff the
    # porcelain worktree list before/after to find whichever path is new.
    local before after new_worktree exit_code
    if ! before=$(git --git-dir "$main_repo/.git" worktree list --porcelain); then
        echo "cxb: failed to read existing worktrees" >&2
        return 1
    fi
    before=$(printf '%s\n' "$before" | rg '^worktree ')

    better-branch \
        --checkout worktree \
        --git-dir "$main_repo/.git" \
        --work-tree "$main_repo" \
        "$@"
    exit_code=$?
    if [ $exit_code -ne 0 ]; then
        echo "cxb: better-branch failed with exit code $exit_code" >&2
        return $exit_code
    fi

    if ! after=$(git --git-dir "$main_repo/.git" worktree list --porcelain); then
        echo "cxb: failed to read updated worktrees" >&2
        return 1
    fi
    after=$(printf '%s\n' "$after" | rg '^worktree ')
    new_worktree=$(comm -13 <(printf '%s\n' "$before" | sort) <(printf '%s\n' "$after" | sort) | sed 's/^worktree //' | head -n 1)

    if [ -z "$new_worktree" ]; then
        echo "cxb: no new worktree was created" >&2
        return 1
    fi

    if ! cd "$new_worktree"; then
        echo "cxb: failed to enter $new_worktree" >&2
        return 1
    fi
}

function zsh_add_plugin() {
    PLUGIN_NAME=$(echo $1 | cut -d "/" -f 2)
    if [ -d "$ZDOTDIR/plugins/$PLUGIN_NAME" ]; then 
        # For plugins
        zsh_add_file "plugins/$PLUGIN_NAME/$PLUGIN_NAME.plugin.zsh" || \
        zsh_add_file "plugins/$PLUGIN_NAME/$PLUGIN_NAME.zsh"
    else
        git clone "https://github.com/$1.git" "$ZDOTDIR/plugins/$PLUGIN_NAME"
    fi
}

function zsh_add_completion() {
    PLUGIN_NAME=$(echo $1 | cut -d "/" -f 2)
    if [ -d "$ZDOTDIR/plugins/$PLUGIN_NAME" ]; then 
        # For completions
		completion_file_path=$(ls $ZDOTDIR/plugins/$PLUGIN_NAME/_*)
		fpath+="$(dirname "${completion_file_path}")"
        zsh_add_file "plugins/$PLUGIN_NAME/$PLUGIN_NAME.plugin.zsh"
    else
        git clone "https://github.com/$1.git" "$ZDOTDIR/plugins/$PLUGIN_NAME"
		fpath+=$(ls $ZDOTDIR/plugins/$PLUGIN_NAME/_*)
        [ -f $ZDOTDIR/.zccompdump ] && $ZDOTDIR/.zccompdump
    fi
	completion_file="$(basename "${completion_file_path}")"
	if [ "$2" = true ] && compinit "${completion_file:1}"
}
